{
  "name": "Orders example — customize before use",
  "columns": {
    "order_id": {"type": "string"},
    "amount": {"type": "number"},
    "country": {"type": "string"},
    "currency": {"type": "string"},
    "placed_at": {"type": "datetime"},
    "shipped_at": {"type": "datetime", "nullable": true, "required": false},
    "status": {"type": "string"},
    "notes": {"type": "string", "nullable": true, "required": false}
  },
  "primary_key": "order_id",
  "datetime_formats": {
    "placed_at": ["iso8601", "%Y-%m-%d"],
    "shipped_at": ["iso8601", "%Y-%m-%d"]
  },
  "chronological_pair": ["placed_at", "shipped_at"],
  "categories": {"status": ["paid", "shipped", "cancelled"]},
  "pair_mappings": [
    {"source": "country", "target": "currency", "pairs": [["IN", "INR"], ["JP", "JPY"], ["US", "USD"]]}
  ],
  "text_columns": ["notes"],
  "null_drift_threshold": 0.2
}
