{
  "name": "Support tickets",
  "columns": {
    "ticket": {"type": "integer"},
    "opened": {"type": "datetime"},
    "resolved": {"type": "datetime", "nullable": true},
    "priority": {"type": "string"},
    "message": {"type": "string"}
